# Environment Configuration
PROJECT_NAME="BrightLoop Product & Pricing API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Supabase PostgreSQL Database URL
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
# For local development/testing fallback, SQLite can be used: sqlite:///./brightloop.db
DATABASE_URL="sqlite:///./brightloop.db"

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,https://brightloop-odoo.vercel.app"
