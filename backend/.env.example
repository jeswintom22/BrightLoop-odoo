# ==========================================
# BrightLoop Backend - Environment Variables
# ==========================================

PROJECT_NAME="BrightLoop Subscription Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ------------------------------------------
# Supabase PostgreSQL Configuration
# ------------------------------------------
# How to obtain your Supabase PostgreSQL connection string:
# 1. Log in to https://supabase.com/dashboard
# 2. Select your project -> Project Settings -> Database.
# 3. Under 'Connection string', choose:
#    - URI (Transaction Pooler - Port 6543) [RECOMMENDED for Render Free Web Service]:
#      postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#    - Direct Connection (Session - Port 5432) [Used for Alembic migrations]:
#      postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# NOTE: For local development / quick testing when offline, you can use SQLite:
# DATABASE_URL="sqlite:///./brightloop.db"
DATABASE_URL="sqlite:///./brightloop.db"

# ------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,https://brightloop-odoo.vercel.app"

# ------------------------------------------
# Database Connection Pool Tuning
# ------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True

# ── Person 4 (billing) ──────────────────────────────────────────────
# Auth (contract owned by Person 1)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# Dev only: skip JWT verification, act as a finance admin. Set false in prod.
AUTH_DEV_BYPASS=true

# Shared secret for POST /api/v1/internal/billing/run (GitHub Actions cron)
INTERNAL_JOB_TOKEN=dev-internal-token

# Email (Resend). Leave the API key empty until a verified sender is configured.
RESEND_API_KEY=
RESEND_FROM="Brightloop Billing <billing@brightloop.example>"
RESEND_WEBHOOK_SECRET=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MINUTES=15
PAYMENT_INSTRUCTIONS="Please use the secure payment options in your account."

DEFAULT_CURRENCY=INR

# Until P2/P3 modules land, billing uses in-process stub providers.
USE_STUB_PROVIDERS=false

# ── Person 4 Phase 2 (revenue intelligence & AI copilot) ────────────
# LLM provider for the copilot, risk explanations and financial summaries.
#   "none"    — deterministic grounded template engine, no external calls
#               (default; safe for dev/CI — answers are still data-grounded)
#   "openai"  — OpenAI chat completions (requires AI_API_KEY)
#   "gemini"  — Google Gemini generateContent (requires AI_API_KEY)
AI_PROVIDER=none
AI_API_KEY=
# Model name: e.g. gpt-4o-mini (openai) or gemini-1.5-flash (gemini)
AI_MODEL=gpt-4o-mini
# Per-request timeout for LLM calls (seconds)
AI_TIMEOUT_S=20
# Max output tokens per LLM call
AI_MAX_TOKENS=800
# Per-user rate limit on AI endpoints (requests/minute, per process)
AI_RATE_LIMIT_PER_MINUTE=20
