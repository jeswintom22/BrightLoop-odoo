# Environment Configuration
PROJECT_NAME="BrightLoop Subscription Management API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Supabase PostgreSQL Database URL
# Format: postgresql+psycopg2://postgres:[PASSWORD]@[SUPABASE-HOST]:6543/postgres
# For local development/testing fallback, SQLite can be used:
DATABASE_URL="sqlite:///./brightloop.db"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Person 4 (billing) ──────────────────────────────────────────────
# Auth (contract owned by Person 1)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# Dev only: skip JWT verification, act as a finance admin. Set false in prod.
AUTH_DEV_BYPASS=true

# Shared secret for POST /api/v1/internal/billing/run (GitHub Actions cron)
INTERNAL_JOB_TOKEN=dev-internal-token

# Email (Resend). Leave empty to disable sending — emails return sent=false.
RESEND_API_KEY=
RESEND_FROM="Brightloop Billing <billing@brightloop.example>"

DEFAULT_CURRENCY=INR

# Until P2/P3 modules land, billing uses in-process stub providers.
USE_STUB_PROVIDERS=true
